    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
